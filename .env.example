# Public site URL (set once the chapter has a custom domain)
# Example: https://wicyskean.org
NEXT_PUBLIC_SITE_URL=

# Keystatic GitHub mode (turns on editing from the live site)
# Leave blank for local editing on your own machine.
NEXT_PUBLIC_KEYSTATIC_GITHUB_REPO=vinnypronel/wicys-kean

# Filled in automatically by the Keystatic GitHub App setup at /keystatic
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=

# Contact form (Resend, https://resend.com). Without a key the form shows
# a fallback message pointing visitors to the chapter email.
RESEND_API_KEY=
# Where messages go. Defaults to the chapter email in site settings.
CONTACT_TO_EMAIL=
# Must be on a domain verified in Resend. Defaults to Resend's test sender.
CONTACT_FROM_EMAIL=
